{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "bio": { "type": "string" },
        "fursona": { "type": "string" },
        "onboarded": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "deactivated": { "type": "boolean" }
      },
      "required": ["uid", "username", "displayName", "onboarded"]
    },
    "Post": {
      "title": "Post",
      "description": "Public community post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "isPinned": { "type": "boolean" },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "authorUid", "authorName", "content", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Comment on a post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "content": { "type": "string" },
        "stickerUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "authorUid", "authorName", "createdAt"]
    },
    "Group": {
      "title": "Group",
      "description": "Public interest group",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "iconUrl": { "type": "string" },
        "creatorUid": { "type": "string" },
        "membersCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "creatorUid", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message in chat or group",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "senderAvatar": { "type": "string" },
        "content": { "type": "string" },
        "stickerUrl": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "senderUid", "senderName", "createdAt"]
    },
    "DirectChat": {
      "title": "DirectChat",
      "description": "Private direct chat channel between two users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array" },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "participants", "updatedAt"]
    },
    "Sticker": {
      "title": "Sticker",
      "description": "Custom sticker created by user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "creatorUid": { "type": "string" },
        "title": { "type": "string" },
        "imageUrl": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "creatorUid", "imageUrl", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Feed posts"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Comments on post"
    },
    "/groups/{groupId}": {
      "schema": { "$ref": "#/entities/Group" },
      "description": "Public groups"
    },
    "/groups/{groupId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages in public group"
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/DirectChat" },
      "description": "Direct chat sessions"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages in direct chat"
    },
    "/stickers/{stickerId}": {
      "schema": { "$ref": "#/entities/Sticker" },
      "description": "Custom stickers"
    }
  }
}
